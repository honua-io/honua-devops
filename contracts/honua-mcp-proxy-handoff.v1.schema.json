{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/honua-mcp-proxy-handoff.v1.json",
  "title": "honua MCP proxy install handoff v1",
  "description": "The secretless CLI/MCP handoff honua-devops writes after a governed apply. It carries locators only: no admin key, no Terraform secret material. The endpoint and admin-key locator normally come from the stack's own honua.operator-contract/v1 projection; when a caller overrode either, the corresponding *Source field says so, because this document decides where a client will send a resolved admin credential. Emission reports install-handoff-written, never ready.",
  "type": "object",
  "required": [
    "schemaVersion",
    "rootProvisioningOperationId",
    "provisioningLineage",
    "candidateReference",
    "endpointSource",
    "adminKeySecretRefSource",
    "operatorContract",
    "proxyArtifact",
    "command",
    "args",
    "env",
    "secretRefs",
    "capabilityContract"
  ],
  "properties": {
    "schemaVersion": { "const": "honua.mcp-proxy.handoff/v1" },
    "rootProvisioningOperationId": { "type": "string", "pattern": "^urn:honua:provisioning:[0-9a-f]{32}$" },
    "provisioningLineage": {
      "type": "object",
      "required": ["provisioningOperationId"],
      "properties": {
        "provisioningOperationId": { "type": "string", "pattern": "^urn:honua:provisioning:[0-9a-f]{32}$" }
      },
      "additionalProperties": true
    },
    "candidateReference": { "type": "string", "minLength": 1 },
    "endpointSource": { "$ref": "#/$defs/identitySource" },
    "adminKeySecretRefSource": { "$ref": "#/$defs/identitySource" },
    "operatorContract": {
      "description": "What the stack reported, retained even when a caller override is in force, so the two can be compared.",
      "type": "object",
      "required": ["digest", "status", "endpoint", "adminKeySecretRef"],
      "properties": {
        "digest": { "type": ["string", "null"], "pattern": "^([0-9a-f]{64})?$" },
        "status": { "type": ["string", "null"] },
        "endpoint": { "type": "string", "format": "uri" },
        "adminKeySecretRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "proxyArtifact": {
      "type": "object",
      "required": ["package", "integrity"],
      "properties": {
        "package": { "type": "string", "pattern": "^@honua/mcp-server@[0-9]+\\.[0-9]+\\.[0-9]+" },
        "integrity": { "type": "string", "pattern": "^sha(256|384|512)-[A-Za-z0-9+/=]+$" }
      },
      "additionalProperties": false
    },
    "command": { "const": "npx" },
    "args": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "env": {
      "description": "Non-secret environment for the proxy process.",
      "type": "object",
      "required": ["HONUA_BASE_URL", "HONUA_MCP_REMOTE_URL"],
      "properties": {
        "HONUA_BASE_URL": { "type": "string", "format": "uri" },
        "HONUA_MCP_REMOTE_URL": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "secretRefs": {
      "description": "Secret LOCATORS resolved by the client at launch. Never secret material.",
      "type": "object",
      "required": ["HONUA_ADMIN_KEY"],
      "properties": {
        "HONUA_ADMIN_KEY": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "capabilityContract": {
      "type": "object",
      "required": ["verification", "required"],
      "properties": {
        "verification": {
          "type": "object",
          "required": ["method", "failClosed"],
          "properties": {
            "method": { "const": "MCP tools/list" },
            "failClosed": { "const": true }
          },
          "additionalProperties": false
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "activation", "serverConfiguration", "requiredToolPrefixes", "requiredTools"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "activation": { "type": "string", "minLength": 1 },
              "serverConfiguration": { "type": "array", "items": { "type": "string" } },
              "requiredToolPrefixes": { "type": "array", "items": { "type": "string" } },
              "requiredTools": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "identitySource": { "enum": ["operator-contract", "caller-override"] }
  },
  "additionalProperties": false
}
