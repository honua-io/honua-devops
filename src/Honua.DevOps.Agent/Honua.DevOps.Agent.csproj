<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Release channels publish self-contained, RID-specific single-file binaries. Listing the
      RIDs here makes packages.lock.json carry a `net10.0/<rid>` target for each, so those
      restores succeed in LOCKED mode. Without it a RID-specific restore cannot be satisfied
      from the lock file, and the release build has to disable locked mode entirely, resolving
      transitive packages that the committed lock file never represented and that the locked
      test lanes never exercised.
    -->
    <RuntimeIdentifiers>linux-x64;osx-x64;osx-arm64;win-x64</RuntimeIdentifiers>
    <!--
      Declared here rather than passed on release command lines. PublishSingleFile pulls in
      Microsoft.NET.ILLink.Tasks, so passing it only at restore time produced a lock file
      whose package set did not match an ordinary `dotnet restore` — every locked lane then
      failed NU1004. Declaring it keeps the package graph identical for ordinary and release
      restores alike. It affects `dotnet publish` only; build and test are unchanged.
    -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.21.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-rc3" />
    <!--
      Keep Microsoft.Extensions.AI aligned with the Microsoft.Extensions.AI.Abstractions
      floor pulled in by ModelContextProtocol.Core. A split train (AI 10.3.x with
      Abstractions 10.5.x) causes TypeLoadException in FunctionInvokingChatClient.
    -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.2" />
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
  </ItemGroup>

</Project>
