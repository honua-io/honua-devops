<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.21.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-rc3" />
    <!--
      Keep Microsoft.Extensions.AI aligned with the Microsoft.Extensions.AI.Abstractions
      floor pulled in by ModelContextProtocol.Core. A split train (AI 10.3.x with
      Abstractions 10.5.x) causes TypeLoadException in FunctionInvokingChatClient.
    -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.2" />
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The published blind-eval scorecard contract lives in `contracts/` so downstream
      consumers (honua-release evidence aggregation) can read it without building this
      repo. It is embedded here so the blind-eval CLI mode validates every artifact it
      writes against the same file, with no second copy to drift.
    -->
    <EmbeddedResource Include="../../contracts/blind-eval-scorecard.v1.schema.json" LogicalName="Honua.DevOps.Agent.contracts.blind-eval-scorecard.v1.schema.json" />
  </ItemGroup>

</Project>
