# Copy selected values into .env or .env.local.
# honua-devops auto-loads .env and .env.local from the working directory.

# Set one provider as default for interactive runs
HONUA_DEVOPS_PROVIDER=codex
HONUA_DEVOPS_EXECUTION_MODE=plan
HONUA_DEVOPS_EXECUTION_TIER=plan
HONUA_DEVOPS_APPROVAL_MODE=pr-first
HONUA_DEVOPS_AUDIT_HOOK_TARGET=stdout-evidence
HONUA_DEVOPS_SUPPORT_SESSION_ACCESS=disabled
HONUA_DEVOPS_SUPPORT_SESSION_TTL_MINUTES=60
HONUA_DEVOPS_SUPPORT_SESSION_CUSTOMER_VISIBLE=true
HONUA_DEVOPS_BREAK_GLASS_POST_REVIEW_REQUIRED=true
HONUA_DEVOPS_GITOPS_TOOL=honua-gitops
HONUA_DEVOPS_ALLOWED_ENVIRONMENTS=dev,staging,prod
HONUA_DEVOPS_TERRAFORM_REPO=https://github.com/honua-io/honua-terraform
HONUA_DEVOPS_TERRAFORM_REF=main
HONUA_DEVOPS_TERRAFORM_TARGETS=azure-functions,lambda,eks,aks,ecs,aca
HONUA_DEVOPS_TERRAFORM_LOCAL_PATH=/home/makani/honua-terraform
HONUA_DEVOPS_DEPLOY_TARGET_ID=

# Deploy/promotion submit poll budget. After a deploy-control operation is submitted the
# executor polls /operations/{id} with capped exponential backoff until it reaches a
# terminal status or this total timeout elapses. If still reconciling at the deadline the
# outcome is reported as `execute-in-progress` (NOT a failure) — the reconciler keeps
# advancing it server-side. Raise the timeout for slow prod deploys/promotions.
HONUA_DEVOPS_DEPLOY_POLL_TIMEOUT_SECONDS=300
HONUA_DEVOPS_DEPLOY_POLL_INITIAL_INTERVAL_MS=1000
HONUA_DEVOPS_DEPLOY_POLL_MAX_INTERVAL_MS=15000

# Console-facing AI DevOps bridge (optional). Base URL used to assemble Console deep
# links in proposal/operation-status/brief projections. When unset, "self" workflow
# links are returned as unavailable rather than fabricated. Server deep links and raw
# evidence refs are always derived from HONUA_DEVOPS_HONUA_API_BASE_URL.
HONUA_DEVOPS_CONSOLE_BASE_URL=

# Operational backends
HONUA_DEVOPS_HONUA_API_BASE_URL=http://localhost:8080
HONUA_DEVOPS_HONUA_API_KEY=
HONUA_DEVOPS_HONUA_READINESS_PATH=/healthz/ready
HONUA_DEVOPS_OTEL_BASE_URL=http://localhost:4318
HONUA_DEVOPS_OTEL_API_KEY=
HONUA_DEVOPS_OTEL_HEALTH_PATH=/
HONUA_DEVOPS_BACKEND_TIMEOUT_SECONDS=20

# Honua support ticket API (optional)
HONUA_DEVOPS_SUPPORT_API_BASE_URL=
HONUA_DEVOPS_SUPPORT_API_TICKETS_PATH=/api/v1/tickets
HONUA_DEVOPS_SUPPORT_API_BEARER_TOKEN=

# Honua support escalation webhook receiver (optional; used with --listen).
# The listener binds to localhost only. Front it with a local tunnel, reverse
# proxy, or same-host honua-support deployment when remote delivery is needed.
# HONUA_DEVOPS_WEBHOOK_SECRET is required when --listen is used and must match
# the HMAC-SHA256 signing secret configured in honua-support.
HONUA_DEVOPS_WEBHOOK_SECRET=
HONUA_DEVOPS_WEBHOOK_PORT=8090
HONUA_DEVOPS_WEBHOOK_PATH=/escalations
HONUA_DEVOPS_WEBHOOK_AUTO_TRIAGE=true

# Work-intake connector (optional; used with --intake-listen). ENTERPRISE EDITION
# ONLY: honua-devops detects the connected server's edition and refuses to bind
# the intake listener below enterprise. Default-off: leave the provider unset (or
# `none`) and intake stays disabled. The listener binds to localhost only — front
# it with a tunnel/proxy for remote delivery. This PR is inbound + write-back stub
# only: a received Jira issue is logged and a "received by honua-devops" provenance
# comment is posted back to the ticket. No deliverable drafting/promotion yet.
#
# HONUA_DEVOPS_INTAKE_PROVIDER must be `jira` to enable; `none` (default) disables.
# Jira Cloud auth is API-token Basic (USER_EMAIL + API_TOKEN). The webhook is
# verified via HONUA_DEVOPS_INTAKE_WEBHOOK_SECRET (HMAC-SHA256 over the raw body).
# Write-back targets must be allowlisted in HONUA_DEVOPS_INTAKE_ALLOWED_HOSTS.
HONUA_DEVOPS_INTAKE_PROVIDER=none
HONUA_DEVOPS_INTAKE_WEBHOOK_SECRET=
HONUA_DEVOPS_INTAKE_PORT=8091
HONUA_DEVOPS_INTAKE_PATH=/intake
HONUA_DEVOPS_INTAKE_ALLOWED_HOSTS=
HONUA_DEVOPS_INTAKE_AUTO_DRAFT=false
HONUA_DEVOPS_JIRA_BASE_URL=
HONUA_DEVOPS_JIRA_API_TOKEN=
HONUA_DEVOPS_JIRA_USER_EMAIL=
HONUA_DEVOPS_JIRA_PROJECT_FILTER=

# Support auto-bundle: forwarding the operator's Honua API key to the support
# backend so it can pull live telemetry from the customer instance. Disabled
# by default. Set HONUA_DEVOPS_SUPPORT_AUTOBUNDLE_ENABLED=true, list the
# instance hosts permitted to receive the forwarded key in
# HONUA_DEVOPS_SUPPORT_AUTOBUNDLE_ALLOWED_HOSTS (comma-separated), and set
# HONUA_DEVOPS_SUPPORT_AUTOBUNDLE_API_KEY to a dedicated key (do NOT reuse
# the primary HONUA_DEVOPS_HONUA_API_KEY).
HONUA_DEVOPS_SUPPORT_AUTOBUNDLE_ENABLED=false
HONUA_DEVOPS_SUPPORT_AUTOBUNDLE_ALLOWED_HOSTS=
HONUA_DEVOPS_SUPPORT_AUTOBUNDLE_API_KEY=

# OTEL endpoint overrides (optional)
HONUA_DEVOPS_OTEL_LOGS_PATH=/v1/logs/search
HONUA_DEVOPS_OTEL_METRICS_PATH=/v1/metrics/search

# Honua server endpoint contracts (optional)
HONUA_DEVOPS_HONUA_ADMIN_ERRORS_PATH=/api/v1/admin/observability/errors
HONUA_DEVOPS_HONUA_ADMIN_TELEMETRY_PATH=/api/v1/admin/observability/telemetry
HONUA_DEVOPS_HONUA_METRICS_HEALTH_PATH=/api/v1/metrics/health
HONUA_DEVOPS_HONUA_METRICS_PERFORMANCE_PATH=/api/v1/metrics/performance
HONUA_DEVOPS_HONUA_METRICS_DATABASE_PATH=/api/v1/metrics/database
HONUA_DEVOPS_HONUA_METRICS_CACHE_PATH=/api/v1/metrics/cache
HONUA_DEVOPS_HONUA_METRICS_MEMORY_PATH=/api/v1/metrics/memory
HONUA_DEVOPS_HONUA_QUERY_CACHE_STATS_PATH=/api/v1/admin/performance/database/query-cache/statistics
HONUA_DEVOPS_HONUA_ADMIN_VERSION_PATH=/api/v1/admin/version
HONUA_DEVOPS_HONUA_ADMIN_CAPABILITIES_PATH=/api/v1/admin/capabilities
HONUA_DEVOPS_HONUA_MANIFEST_EXPORT_PATH=/api/v1/admin/manifest
HONUA_DEVOPS_HONUA_MANIFEST_APPLY_PATH=/api/v1/admin/manifest/apply
HONUA_DEVOPS_HONUA_DEPLOY_PREFLIGHT_PATH=/api/v1/admin/deploy/preflight
HONUA_DEVOPS_HONUA_DEPLOY_PLAN_PATH=/api/v1/admin/deploy/plan
HONUA_DEVOPS_HONUA_DEPLOY_OPERATIONS_PATH=/api/v1/admin/deploy/operations
HONUA_DEVOPS_HONUA_METADATA_RELEASE_OPERATIONS_PATH=/api/v1/admin/metadata/releases/operations
HONUA_DEVOPS_HONUA_METADATA_RELEASE_BY_PACKAGE_PATH=/api/v1/admin/metadata/releases
HONUA_DEVOPS_HONUA_MANIFEST_DRIFT_PATH=/api/v1/admin/manifest/drift
HONUA_DEVOPS_HONUA_MANIFEST_VERSIONS_PATH=/api/v1/admin/manifest/versions

# Live integration tests (opt-in)
HONUA_DEVOPS_LIVE_INTEGRATION=false
HONUA_DEVOPS_LIVE_DESIRED_REVISION=honua-devops-live-test
# Set to true (along with the three HONUA_DEVOPS_LOCAL_LLAMA_* vars below) to
# run LiveLocalLlamaIntegrationTests against a real NIM endpoint
# (build.nvidia.com, self-hosted, AWS Marketplace, or the Honua-GIS-32B
# deployment from honua-io/honua-sdk-python#64). Defaults to false so PR/main
# CI lanes never hit a NIM endpoint.
HONUA_DEVOPS_LIVE_LOCAL_LLAMA=false

# Legacy aliases are still accepted for compatibility:
# HONUA_DEVOPS_HONUA_HEALTH_PATH=/healthz/ready
# HONUA_DEVOPS_HONUA_TROUBLESHOOT_PATH=/api/v1/admin/observability/errors
# HONUA_DEVOPS_HONUA_TUNE_PATH=/api/v1/metrics/performance
# HONUA_DEVOPS_HONUA_UPGRADE_PATH=/api/v1/admin/version
# HONUA_DEVOPS_HONUA_DEPLOY_PATH=/api/v1/admin/manifest/apply
# HONUA_DEVOPS_HONUA_REQUIREMENTS_PATH=/api/v1/admin/capabilities
# HONUA_DEVOPS_HONUA_TOPOLOGY_PATH=/api/v1/admin/observability/telemetry

# Codex (OpenAI-compatible)
HONUA_DEVOPS_CODEX_MODEL=
HONUA_DEVOPS_CODEX_API_KEY=
HONUA_DEVOPS_CODEX_ENDPOINT=

# Claude (OpenAI-compatible endpoint or gateway)
HONUA_DEVOPS_CLAUDE_MODEL=
HONUA_DEVOPS_CLAUDE_API_KEY=
HONUA_DEVOPS_CLAUDE_ENDPOINT=

# LocalLlama (NVIDIA NIM / OpenAI-compatible)
# Hosted developer tier: https://build.nvidia.com — sign in, pick a model, and
#   copy the model id (e.g. meta/llama-3.3-70b-instruct), an NVAPI key, and the
#   API base URL (https://integrate.api.nvidia.com/v1) into the three vars
#   below.
# Self-hosted NIM: launch the NIM container, set ENDPOINT to
#   https://<host>:8000/v1 (http://localhost:8000/v1 is permitted for loopback)
#   and API_KEY to your gateway key.
# AWS Marketplace NIM: subscribe to the NIM AMI / EKS chart and follow
#   docs/deployments/nvidia-nim.md.
# Honua-GIS-32B (canonical Honua-tuned target — values are issued by
#   honua-io/honua-sdk-python#64 / 64.10 once that ticket lands):
#     HONUA_DEVOPS_LOCAL_LLAMA_MODEL=honua/honua-gis-32b
#     HONUA_DEVOPS_LOCAL_LLAMA_API_KEY=<issued-by-64.10>
#     HONUA_DEVOPS_LOCAL_LLAMA_ENDPOINT=https://<gis-nim-host>/v1
HONUA_DEVOPS_LOCAL_LLAMA_MODEL=
HONUA_DEVOPS_LOCAL_LLAMA_API_KEY=
HONUA_DEVOPS_LOCAL_LLAMA_ENDPOINT=
