{
  "schemaVersion": "1",
  "serverReport": {
    "defaultPath": "../honua-server/tests/TestResults/eval-report.json",
    "scenarioDir": "../honua-server/tests/dotnet/eval/scenarios",
    "allowedScenarioStatuses": ["Passed", "PassedWithSkips"]
  },
  "scoreDimensions": [
    "clarificationQuality",
    "planValidity",
    "executionSuccess",
    "resultCorrectness",
    "packageUsefulness"
  ],
  "lanes": [
    {
      "id": "claude",
      "displayName": "Claude",
      "role": "release-gate",
      "provider": "claude",
      "enabledEnv": "HONUA_EVAL_CLAUDE_ENABLED",
      "commandEnv": "HONUA_EVAL_CLAUDE_COMMAND",
      "modelEnv": "HONUA_DEVOPS_CLAUDE_MODEL",
      "secretEnv": "HONUA_DEVOPS_CLAUDE_API_KEY",
      "requiredForRelease": true
    },
    {
      "id": "codex",
      "displayName": "Codex",
      "role": "release-gate",
      "provider": "codex",
      "enabledEnv": "HONUA_EVAL_CODEX_ENABLED",
      "commandEnv": "HONUA_EVAL_CODEX_COMMAND",
      "modelEnv": "HONUA_DEVOPS_CODEX_MODEL",
      "secretEnv": "HONUA_DEVOPS_CODEX_API_KEY",
      "requiredForRelease": true
    },
    {
      "id": "bedrock",
      "displayName": "Claude on Amazon Bedrock",
      "role": "portability",
      "provider": "bedrock",
      "enabledEnv": "HONUA_EVAL_BEDROCK_ENABLED",
      "commandEnv": "HONUA_EVAL_BEDROCK_COMMAND",
      "modelEnv": "HONUA_DEVOPS_BEDROCK_MODEL",
      "secretEnv": "HONUA_DEVOPS_BEDROCK_API_KEY",
      "regionEnv": "HONUA_DEVOPS_BEDROCK_REGION",
      "requiredForRelease": false,
      "notes": "Deployment-portability lane for the shipped BedrockChatClientAdapter (ProviderKind.Bedrock, Converse API, AWS credential chain). It is not a second release authority: it hosts the same model family as the `claude` lane, so it tracks hosting/API-surface regressions rather than model-quality regressions. The API key is optional; without it the adapter uses the AWS credential chain."
    },
    {
      "id": "local-llama",
      "displayName": "Local Llama",
      "role": "portability",
      "provider": "local-llama",
      "enabledEnv": "HONUA_EVAL_LOCAL_LLAMA_ENABLED",
      "commandEnv": "HONUA_EVAL_LOCAL_LLAMA_COMMAND",
      "modelEnv": "HONUA_DEVOPS_LOCAL_LLAMA_MODEL",
      "secretEnv": "HONUA_DEVOPS_LOCAL_LLAMA_API_KEY",
      "endpointEnv": "HONUA_DEVOPS_LOCAL_LLAMA_ENDPOINT",
      "requiredForRelease": false
    }
  ]
}
